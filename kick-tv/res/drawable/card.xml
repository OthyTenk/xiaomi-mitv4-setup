<?xml version="1.0" encoding="utf-8"?>
<!-- The remote moves focus, so the focused card has to stand out from across the room. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2A3137" />
            <stroke android:width="3dp" android:color="#53FC18" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#171B1E" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
